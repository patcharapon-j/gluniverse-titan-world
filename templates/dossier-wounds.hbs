<div class="wd">
 <div class="wcol">
  <div class="sec"><span class="num">§1</span>Hit locations</div>
  <figure class="bodyfig{{#if figureFlags.dead}} is-kia{{else}}{{#if figureFlags.coma}} is-coma{{/if}}{{/if}}">
   <i class="ruled" aria-hidden="true"></i>
   {{{figure}}}
   {{#if figureFlags.dead}}
   <div class="wplate kia" role="status"><i class="wband" aria-hidden="true"></i><span class="ws">{{#if isTitan}}Killed{{else}}KIA{{/if}}</span><small>{{#if isTitan}}Nape severed · record closed{{else}}Killed in action · file closed{{/if}}</small></div>
   {{else}}{{#if figureFlags.coma}}
   <div class="wplate coma" role="status"><span class="ws">Coma</span><small>Maximum consciousness 0 · GM review</small></div>
   {{/if}}{{/if}}
   <figcaption><span>Fig. 1 — {{#if d.titan}}Titan{{else}}Human{{/if}} body, anterior</span><span>R · L</span></figcaption>
  </figure>
  <button type="button" class="anatomy-inspect" popovertarget="{{figureDetailId}}">Inspect wounds <span aria-hidden="true">↗</span></button>
  <div id="{{figureDetailId}}" class="bodyfig anatomy-detail" popover role="dialog" aria-label="Wound detail">
   <div class="anatomy-detail-bar"><span>Anatomical study · {{#if d.titan}}Titan{{else}}Human{{/if}}</span><button type="button" popovertarget="{{figureDetailId}}" popovertargetaction="hide" aria-label="Close wound detail">Close ×</button></div>
   {{{figureDetail}}}
   <p class="anatomy-detail-note">{{#if figureFlags.dead}}Deceased · {{else}}{{#if figureFlags.coma}}Coma · {{/if}}{{/if}}Current injuries · anterior view · R / L</p>
  </div>
  <div class="legend clinical-key">
   <span><i class="minor"></i>Minor</span><span><i class="major"></i>Major</span><span><i class="crippling"></i>Crippling</span>
  </div>
  <dl class="wsum">
   <div><dt>Lost to wounds</dt><dd class="{{#if d.woundLoss}}pen{{/if}}">−{{d.woundLoss}}</dd></div>
   <div><dt>Consciousness</dt><dd>{{d.value}} / {{d.max}}</dd></div>
   <div><dt>Death at</dt><dd>{{track.deathAt}}</dd></div>
   <div><dt>Rest</dt><dd class="{{#if d.restBlocked}}pen{{/if}}">{{#if d.restBlocked}}Blocked{{else}}Open{{/if}}</dd></div>
  </dl>
  {{#if editable}}
  <div class="wbtns">
   <button type="button" class="mini primary" data-action="addWound">{{twIcon 'drop'}}Record injury</button>
   <button type="button" class="mini" data-action="openCompendium" data-pack="injuries">{{twIcon 'book'}}Templates</button>
  </div>
  {{/if}}
 </div>

 <div class="wcol">
  <div class="sec"><span class="num">§2</span>Injury log<span class="k">{{#if d.titan}}Titan{{else}}Human{{/if}} body only</span></div>
  <div class="wtable">
   {{#each ledger}}
   <div class="wrow {{severity}}{{#if clear}} clear{{/if}}">
    <div class="lc" title="{{hint}}">
     <span class="lch">{{twIcon icon}}<b>{{short}}</b><span class="pips">{{#each pips}}<i class="pip{{#if filled}} on{{/if}}"></i>{{/each}}</span></span>
     <small class="{{#if applied}}pen{{/if}}">{{#if applied}}{{appliedShort}}{{else}}{{#if live}}No penalty{{else}}Clear{{/if}}{{/if}}</small>
    </div>
    <div class="det">
     {{#each wounds}}
     <div class="wentry {{severity}}{{#if treated}} treated{{/if}}{{#if healed}} healed{{/if}}" data-wound="{{id}}">
      <div class="wtop">
       <span class="wmark s-{{severity}} t-{{type}}" title="{{severityLabel}} {{typeLabel}}">{{twIcon typeIcon}}<i></i><i></i><i></i></span>
       <b>{{severityLabel}} · {{typeLabel}}</b>
       {{#if label}}<span class="wname" title="{{label}}">{{label}}</span>{{/if}}
       <span class="wtags">
        {{#if penalty}}<i class="tg pen">{{penalty}}</i>{{/if}}
        {{#if loss}}<i class="tg pen">−{{loss}} consc.</i>{{/if}}
        {{#if mindless}}<i class="tg pen">Mind = −3</i>{{/if}}
        {{#if blocksRest}}<i class="tg warn">Blocks rest</i>{{/if}}
        {{#if treated}}<i class="tg ok">Treated</i>{{else}}{{#unless healed}}<i class="tg warn">Untreated</i>{{/unless}}{{/if}}
        {{#if fromMajor}}<i class="tg">From a major</i>{{/if}}
        {{#if healed}}<i class="tg done">Healed</i>{{/if}}
       </span>
       {{#if ../../editable}}
       <span class="wact">
        {{#unless healed}}<button type="button" class="mini wtreat{{#if amputate}} danger{{/if}}" data-action="treatWound" data-item-id="{{id}}">{{#if amputate}}{{twIcon 'blade'}}Amputate{{else}}{{twIcon 'bandage'}}Treat{{/if}}</button>{{/unless}}
        <button type="button" class="mini icon" data-action="toggleHealed" data-item-id="{{id}}" aria-label="{{#if healed}}Reopen{{else}}Mark healed{{/if}}" title="{{#if healed}}Reopen{{else}}Mark healed{{/if}}">{{#if healed}}{{twIcon 'refresh'}}{{else}}{{twIcon 'check'}}{{/if}}</button>
        <button type="button" class="mini icon" data-action="editItem" data-item-id="{{id}}" aria-label="Edit {{name}}" title="Edit">{{twIcon 'edit'}}</button>
        <button type="button" class="mini icon danger" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}" title="Remove">{{twIcon 'trash'}}</button>
       </span>
       {{/if}}
      </div>
      {{#unless healed}}
      <ul class="weff">
       {{#each effects}}<li>{{this}}</li>{{/each}}
       {{#if fromMajor}}<li>Healed down from a major wound, so rest cannot clear it before the mission ends.</li>{{/if}}
      </ul>
      {{/unless}}
     </div>
     {{else}}<span class="none">No injury recorded.</span>{{/each}}
    </div>
   </div>
   {{/each}}
  </div>
  <p class="note">Only wounds on the current body affect statistics. The GM rules on bleeding, amputation and recovery.</p>
 </div>
</div>
