<div class="gr">
 <div class="gcol">
  <div class="sec">
   <span class="num">§1</span>Carried equipment<span class="k">{{gear.length}} entries</span>
   {{#if editable}}<button type="button" class="mini" data-action="openCompendium" data-pack="equipment">{{icon 'book'}}Compendium</button>{{/if}}
  </div>
  <div class="inv">
   {{#each gear}}
   <div class="irow{{#unless system.equipped}} stowed{{/unless}}{{#if empty}} out{{/if}}" data-item-id="{{id}}" draggable="true">
    <label class="chk" title="Carried and active">
     <input type="checkbox" data-action="toggleEquipped" data-item-id="{{id}}" {{checked system.equipped}} aria-label="Carried">
    </label>
    <button type="button" class="iname" data-action="editItem" data-item-id="{{id}}">
     {{icon icon}}<span>{{name}}</span>
     {{#if modifier}}<i class="tg pen">{{modifier}}</i>{{/if}}
     {{#if system.uses}}<i class="tg">{{system.uses}} uses</i>{{/if}}
    </button>
    <span class="iq"><b data-live="gear-{{id}}">{{quantity}}</b>{{#if capacity}}<small>/{{capacity}}</small>{{/if}}</span>
    <span class="num tight">
     <button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="-1" aria-label="Use one {{name}}" {{#if empty}}disabled{{/if}}>{{icon 'minus'}}</button>
     <button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="1" aria-label="Add one {{name}}">{{icon 'plus'}}</button>
    </span>
    <button type="button" class="mini icon danger" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">{{icon 'trash'}}</button>
   </div>
   {{else}}
   <p class="empty">Nothing carried. Equip a loadout, or drag equipment in from the compendium.</p>
   {{/each}}
  </div>
  <p class="note">Ammunition and gas are abstract supplies. Adjust counts when the GM calls for expenditure; nothing is consumed automatically. Capacity, set on the item, drives the field-kit pips on the overview.</p>
 </div>

 <aside class="gside">
  <section class="box">
   <div class="sec"><span class="num">§2</span>Requisition</div>
   {{#if editable}}<button type="button" class="mini wide primary" data-action="equipLoadout">{{icon 'pack'}}Equip a loadout</button>{{/if}}
   <div class="loadouts">
    {{#each loadouts}}
    <div class="lrow">
     <span>{{icon 'pack'}}{{name}}</span>
     <span class="lact">
      <button type="button" class="mini" data-action="useLoadout" data-item-id="{{id}}">Unpack</button>
      <button type="button" class="mini icon danger" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">{{icon 'trash'}}</button>
     </span>
    </div>
    {{else}}<p class="empty">No stored loadout sheets.</p>{{/each}}
   </div>
  </section>
  <section class="box">
   <div class="sec"><span class="num">§3</span>Applied modifiers<span class="k">at source</span></div>
   <div class="ledger">
    {{#each stats}}{{#if anyReason}}
    <div class="lgrow s-{{tone}}">
     <div class="lghead">{{icon icon}}<span>{{label}}</span><em>{{value}} → <b>{{display}}</b></em></div>
     {{#each reasons}}
     <div class="lgline{{#if atRoll}} atroll{{/if}}"><i class="{{tone}}">{{display}}</i><span>{{label}}{{#if atRoll}} <small>applied at the roll</small>{{/if}}</span></div>
     {{/each}}
    </div>
    {{/if}}{{/each}}
    {{#unless anyModifier}}<p class="empty">Nothing is modifying this character. Every statistic is at its base value.</p>{{/unless}}
   </div>
   <p class="note">Every difference between a base statistic and its effective value, named at source. Carried gear applies its modifier only while marked carried; dodge fatigue is spent at the moment you roll.</p>
  </section>
 </aside>
</div>
