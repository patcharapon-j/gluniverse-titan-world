<div class="overview-grid">
 <main class="overview-main">
  <div class="section-head"><h2 class="section-title"><span>01</span> Aptitude assessment</h2>{{#if editable}}<button type="button" class="text-button" data-action="advance">Advance <i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>{{/if}}</div>
  <div class="stat-grid">{{#each stats}}<div class="stat {{#if modified}}modified{{/if}}">
   <button type="button" class="stat-roll" data-action="rollStat" data-stat="{{key}}" aria-label="Roll {{label}} {{display}}"><span class="stat-label">{{label}}</span><span class="stat-description">{{description}}</span><span class="stat-value" data-live="stat-{{key}}">{{display}}</span><span class="roll-mark"><i class="fa-solid fa-dice" aria-hidden="true"></i> Roll</span></button>
   <label class="base-stat">Base <input name="system.stats.{{key}}" type="number" min="-3" max="3" value="{{value}}" aria-label="Base {{label}}"></label>{{#if modified}}<span class="modifier-note">Adjusted</span>{{/if}}{{#if advanced}}<span class="advancement-mark" title="Advanced">↑</span>{{/if}}
  </div>{{/each}}</div>
  <section class="condition-section"><div class="section-head"><h2 class="section-title"><span>02</span> Physical condition</h2><span class="section-caption">{{#if d.titan}}Titan{{else}}Human{{/if}} body</span></div>
  <div class="condition-grid">{{#each regions}}<button type="button" class="condition-region {{severity}}" data-action="twTab" data-tab="injuries" aria-label="{{label}}: {{summary}}"><span>{{label}}</span><small>{{summary}}</small><span class="pips">{{#each pips}}<i class="pip {{#if filled}}filled{{/if}}"></i>{{/each}}</span></button>{{/each}}</div></section>
  <section class="engagement"><div class="section-head"><h2 class="section-title"><span>03</span> Titan engagement</h2><button type="button" class="text-button" data-action="twTab" data-tab="actions">All actions →</button></div><div class="quick-actions">{{#each quickMoves}}<button type="button" data-action="rollMove" data-key="{{system.key}}"><span>{{name}}</span><small>Roll + {{system.stat}}</small><i class="fa-solid fa-angle-right" aria-hidden="true"></i></button>{{/each}}</div></section>
  {{#if d.deathReview}}<p class="warning">Death threshold reached. GM review required.</p>{{/if}}{{#if d.combatDifficult}}<p class="warning">Combat rolls are difficult at this consciousness.</p>{{/if}}
 </main>
 <aside class="field-sidebar">
  <section class="field-box"><h2 class="section-title"><span>04</span> Field kit</h2><div class="kit-list">{{#each kit}}<div class="kit-row {{#if empty}}depleted{{/if}}"><button type="button" class="kit-name" data-action="editItem" data-item-id="{{id}}">{{name}}{{#if system.uses}}<small>{{system.uses}} uses remaining</small>{{/if}}</button><span data-live="kit-{{id}}" class="kit-count">{{system.quantity}}</span><button type="button" class="kit-spend" data-action="quantity" data-item-id="{{id}}" data-delta="-1" aria-label="Use one {{name}}" {{#if empty}}disabled{{/if}}>−</button></div>{{else}}<p class="empty">No carried equipment.<br>Prepare a loadout before departure.</p>{{/each}}</div><button type="button" class="text-button" data-action="twTab" data-tab="equipment">Manage equipment →</button></section>
  <section class="field-box luck-box"><div class="section-head"><h2 class="section-title"><span>05</span> Shared luck</h2>{{#if party}}<span class="luck-total" data-live="party-luck">{{party.value}}<small>/ {{party.max}}</small></span>{{/if}}</div>{{#if party}}<div class="pips luck-pips" aria-label="{{party.value}} luck remaining">{{#each luckPips}}<i class="pip {{#if filled}}filled{{/if}}"></i>{{/each}}</div><p class="note">One pool. Every soldier.<br>Request a spend from your roll in chat.</p><button type="button" data-action="openParty">Open party pool</button>{{else}}{{#if isGM}}<button type="button" data-action="createParty">Create shared pool</button>{{else}}<p class="note">Awaiting the GM's party pool.</p>{{/if}}{{/if}}</section>
  <section class="field-box"><h2 class="section-title"><span>06</span> Readiness</h2><label class="field">Dodge fatigue<input type="number" min="0" name="system.fatigue" value="{{system.fatigue}}"></label><button type="button" data-action="catchBreath">Catch breath</button><label class="check-field"><input type="checkbox" name="system.nextDifficult" {{checked system.nextDifficult}}> Next roll difficult</label>
  <details><summary>Consciousness adjustments</summary><label class="field">Other loss<input type="number" name="{{lossPath}}" value="{{loss}}"></label><label class="field">Maximum adjustment<input type="number" name="{{maxPath}}" value="{{maxAdjustment}}"></label><p class="note">Wound loss: {{d.woundLoss}}. Negative other loss restores consciousness.</p><label class="check-field"><input type="checkbox" name="system.dead" {{checked system.dead}}> Deceased, by GM ruling</label></details></section>
  {{#if editable}}<button type="button" class="recruit-button" data-action="createCharacter"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i> Create character</button>{{/if}}
 </aside>
</div>
