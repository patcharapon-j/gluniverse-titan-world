<div class="ov">
 <div class="ov-main">
  <div class="sec">
   <span class="num">§1</span>Statistics<span class="k">click a card to roll 2d6</span>
   {{#unless isTitan}}{{#if editable}}<button type="button" class="mini" data-action="advance">{{twIcon 'arrowUp'}}Advance</button>{{/if}}{{/unless}}
  </div>
  <div class="stats">
   {{#each stats}}
   <div class="stat s-{{tone}}{{#if modified}} modified{{/if}}{{#if penalty}} penalised{{/if}}" title="{{label}} {{display}}: {{description}}{{#if why}} — {{why}}{{/if}}">
    <button type="button" class="stat-hit" data-action="rollStat" data-stat="{{key}}" aria-label="Roll {{label}} {{display}}"></button>
    <div class="stat-key">
     <span class="big" data-live="stat-{{key}}"><span class="sign">{{sign}}</span>{{abs}}</span>
     <label class="base" title="Base {{label}}"><input type="number" name="system.stats.{{key}}" min="-3" max="3" step="1" value="{{value}}" aria-label="Base {{label}}"><span>base</span></label>
    </div>
    <div class="stat-body">
     <div class="stat-top">
      {{twIcon icon}}<span class="name">{{label}}</span>
      {{#if advanced}}<span class="adv" title="Advanced this campaign">{{twIcon 'arrowUp'}}</span>{{/if}}
     </div>
     {{#if anyReason}}
     <div class="rsns">
      {{#each shown}}<i class="rsn {{tone}}{{#if atRoll}} atroll{{/if}}" title="{{display}} {{label}}{{#if atRoll}} — applied when you roll{{/if}}">{{display}} {{short}}</i>{{/each}}
      {{#if extra}}<i class="rsn more" title="Full breakdown on the Gear tab">+{{extra}} more</i>{{/if}}
     </div>
     {{/if}}
    </div>
    <span class="rollmark">{{twIcon 'dice'}}Roll</span>
   </div>
   {{/each}}
  </div>

  <div class="sec"><span class="num">§2</span>Condition<span class="k">{{#if d.titan}}Titan{{else}}Human{{/if}} body · click for the log</span></div>
  <div class="cond-wrap">
  <button type="button" class="minifig" data-action="twTab" data-tab="injuries" aria-label="Open the injury log">{{{miniFigure}}}</button>
  <div class="cond">
   {{#each ledger}}
   <button type="button" class="loc {{severity}}" data-region="{{key}}" data-action="twTab" data-tab="injuries" aria-label="{{label}}: {{headline}}{{#if applied}}, {{applied}}{{/if}}">
    <span class="nm">{{twIcon icon}}<span>{{short}}</span><span class="pips">{{#each pips}}<i class="pip{{#if filled}} on{{/if}}"></i>{{/each}}</span></span>
    <span class="sv">{{headline}}</span>
    {{#if applied}}<b class="ap" title="{{applied}}">{{appliedShort}}</b>{{/if}}
   </button>
   {{/each}}
  </div>
  </div>

  {{#unless isTitan}}
  <div class="sec">
   <span class="num">§3</span>Engagement<span class="k">the rolls you reach for first</span>
   <button type="button" class="mini" data-action="twTab" data-tab="actions">All {{actionCount}}{{twIcon 'chevron'}}</button>
  </div>
  <div class="engage">
   {{#each quickActions}}{{#if primary}}
   <button type="button" class="act primary" data-action="rollMove" data-key="{{key}}">
    {{twIcon icon}}<span class="an">{{alias}}<small>{{name}} · {{statLabel}} {{modDisplay}}</small></span>{{twIcon 'dice'}}
   </button>
   {{/if}}{{/each}}
   <div class="fearbar f-{{fear.tone}}">
    <span class="fl">{{twIcon fear.icon}}Fear</span>
    <span class="fseg" role="group" aria-label="Fear state">
     {{#each fear.states}}
     <button type="button" class="{{#if on}}on{{/if}}" data-action="setFear" data-state="{{key}}" title="{{line}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{label}}</button>
     {{/each}}
    </span>
    <span class="fp" data-live="fear">{{fear.line}}</span>
   </div>
   <div class="acts wide">
    {{#each quickActions}}{{#unless primary}}
    <button type="button" class="act s-{{tone}}{{#if difficult}} hard{{/if}}" data-action="rollMove" data-key="{{key}}">
     {{twIcon icon}}<span class="an">{{name}}<small>{{statShort}} {{modDisplay}}{{#if difficult}} · difficult{{/if}}</small></span>
    </button>
    {{/unless}}{{/each}}
   </div>
  </div>
  {{/unless}}

  {{#if warnings}}
  <div class="sec"><span class="num">{{#if isTitan}}§3{{else}}§4{{/if}}</span>Standing rulings<span class="k">{{warnings.length}} in force</span></div>
  <div class="alerts">
   {{#each warnings}}<div class="alert {{tone}}">{{twIcon icon}}<span>{{text}}</span></div>{{/each}}
  </div>
  {{/if}}
 </div>

 <aside class="side">
{{#if isTitan}}
  {{!-- The Titan's rail is kept on iron: its size against the heights it meets, the bites strap, then its hide. --}}
  <section class="box rail">
   <div class="sec"><span class="num">§4</span>Specimen</div>
   <div class="spec">
    <label class="spec-h" title="Standing height in metres"><input type="number" name="{{reach.path}}" min="0" step="0.5" value="{{reach.own}}" aria-label="Titan height in metres"><span>metres</span></label>
    <span class="spec-n{{#if system.dead}} severed{{/if}}"><b>{{twIcon 'target'}}Nape {{titanRail.nape}}</b><small>Body fixed at +3 · the nape is the only kill</small></span>
   </div>
   <div class="ruler" role="img" aria-label="Heights this Titan meets hand to hand: {{reach.bandLabel}}">
    {{#each reach.cells}}<i class="rc {{verdict}}" title="{{title}}"><b>{{label}}</b></i>{{/each}}
   </div>
   <div class="rband"><span>Meets</span><b>{{reach.bandLabel}}</b><span>hard from {{reach.difficultLabel}}</span></div>
   <details class="tuck">
    <summary>{{twIcon 'caret'}}Reach rulings</summary>
    <ul class="rlines">{{#each reach.lines}}<li class="rl-{{tone}}">{{twIcon icon}}<span>{{text}}</span></li>{{/each}}</ul>
   </details>
   <div class="rail-checks">
    <label class="check"><input type="checkbox" name="system.nextDifficult" {{checked system.nextDifficult}}><span>Next roll difficult</span></label>
    <label class="check"><input type="checkbox" name="system.dead" {{checked system.dead}}><span>Killed, by GM ruling</span></label>
   </div>
  </section>

  <section class="box rail">
   <div class="sec"><span class="num">§5</span>Bites</div>
   <div class="bites b-{{bites.severity}}">
    <div class="btop">
     <span class="bl"><b data-live="bites" data-live-bad="up">{{bites.bites}}</b><small>{{bites.label}}</small></span>
     {{#if editable}}<span class="num tight">
      <button type="button" data-action="nudge" data-path="system.bites" data-delta="-1" data-min="0" aria-label="One bite fewer">{{twIcon 'minus'}}</button>
      <button type="button" data-action="nudge" data-path="system.bites" data-delta="1" data-min="0" aria-label="One bite more">{{twIcon 'plus'}}</button>
     </span>{{/if}}
    </div>
    <div class="btrack" role="group" aria-label="{{bites.bites}} bites recorded, major at {{bites.major}}, crippling at {{bites.crippling}}">
     {{#each bites.boxes}}<button type="button" class="bb{{#if taken}} on{{/if}}{{#if mark}} at-{{mark}}{{/if}}" data-action="setPath" data-path="system.bites" data-value="{{to}}" title="{{title}}" aria-label="{{title}}"{{#unless ../editable}} disabled{{/unless}}></button>{{/each}}
    </div>
    <div class="bmarks"><span>major at {{bites.major}}</span><span>crippling at {{bites.crippling}}</span></div>
   </div>
  </section>

  <section class="box rail rail-hide{{#if titanRail.steam}} steaming{{/if}}">
   <div class="sec"><span class="num">§6</span>Hide &amp; regrowth</div>
   {{#if titanRail.armour}}
   <label class="aplate{{#unless system.shift.armourIntact}} broken{{/unless}}" data-armour>
    <input type="checkbox" name="system.shift.armourIntact" {{checked system.shift.armourIntact}}>
    <span class="ap-face" aria-hidden="true"><svg class="ap-crack" viewBox="0 0 40 30"><path d="M21 0l-3 9 5 5-6 7 3 9M18 9l-9 4-3-2M23 14l10-2 3 3"/></svg></span>
    <span class="ap-t"><b>{{#if system.shift.armourIntact}}Plating intact{{else}}Plating broken{{/if}}</b><small>{{#if system.shift.armourIntact}}Bites halved · major at {{bites.major}}{{else}}Tick the plate once it has regrown{{/if}}</small></span>
   </label>
   {{else}}<p class="rail-bare">{{twIcon 'shield'}}Bare hide · no plating</p>{{/if}}
   <div class="regen">
    {{#if titanRail.steam}}
    <i class="vapour" aria-hidden="true"><i></i><i></i><i></i></i>
    {{#each titanRail.regen}}<div class="regrow s-{{key}}"><b>{{count}}</b><span>{{label}}</span><small>closes {{pace}}</small></div>{{/each}}
    <button type="button" class="mini wide" data-action="twTab" data-tab="injuries">{{twIcon 'drop'}}{{titanRail.steam}} steaming shut</button>
    {{else}}<p class="rail-bare">{{twIcon 'check'}}Flesh whole · nothing regrowing</p>{{/if}}
   </div>
  </section>

{{else}}
  <section class="box">
   <div class="sec"><span class="num">§5</span>Field kit<button type="button" class="mini" data-action="twTab" data-tab="equipment">Rig &amp; bag{{twIcon 'chevron'}}</button></div>
   <div class="kit">
    {{#each kit.containers}}
    <div class="krow k-{{object}}{{#if empty}} out{{/if}}" data-kit-id="{{id}}">
     <button type="button" class="kl" data-action="editItem" data-item-id="{{id}}" title="{{name}}">{{label}}</button>
     {{> "systems/gluniverse-titan-world/templates/dossier-kit-slots.hbs"}}
     <span class="kq"><b data-live="kit-{{id}}">{{quantity}}</b>{{#if capacity}}<small>/{{capacity}}</small>{{/if}}</span>
    </div>
    {{else}}
    <p class="empty">No supplies carried.<br>Prepare a loadout before departure.</p>
    {{#if editable}}<button type="button" class="mini wide" data-action="equipLoadout">{{twIcon 'pack'}}Equip a loadout</button>{{/if}}
    {{/each}}
   </div>
  </section>

  <section class="box">
   <div class="sec"><span class="num">§6</span>Shared luck</div>
   {{#if party}}
   <div class="luckbox">
    <div class="lt" title="One pool, every soldier. Request a spend from your own roll card in chat."><span data-live="party-luck">{{party.value}}</span><small>/{{party.max}}</small>
     <span class="pips luck">{{#each luckPips}}<i class="pip round{{#if filled}} on{{/if}}"></i>{{/each}}</span>
     <button type="button" class="mini icon" data-action="openParty" aria-label="Open the pool" title="Open the pool">{{twIcon 'users'}}</button>
    </div>
   </div>
   {{else}}{{#if isGM}}<button type="button" class="mini wide" data-action="createParty">{{twIcon 'plusSquare'}}Create a shared pool</button>
   {{else}}<p class="empty">Awaiting the GM's pool.</p>{{/if}}{{/if}}
  </section>

  <section class="box">
   <div class="sec"><span class="num">§7</span>Melee reach<span class="k">hand-to-hand</span></div>
   <div class="reach{{#if reach.bodyGate}} gated{{/if}}">
    <div class="rhead">
     <label class="rh-own" title="Your own height in metres">
      <input type="number" name="{{reach.path}}" min="0" step="0.1" value="{{reach.own}}" aria-label="Your height in metres">
      <span>{{reach.ownLabel}}</span>
     </label>
     <span class="rh-band"><b>{{reach.bandLabel}}</b><small>Titans you can engage</small></span>
    </div>
    <div class="ruler" role="img" aria-label="Titan heights within hand-to-hand reach: {{reach.bandLabel}}">
     {{#each reach.cells}}<i class="rc {{verdict}}" title="{{title}}"><b>{{label}}</b></i>{{/each}}
    </div>
    <div class="rkey"><span><i class="rc in"></i>reach</span><span><i class="rc hard"></i>difficult</span><span><i class="rc fail"></i>auto-fail</span><span><i class="rc out"></i>out</span></div>
    <ul class="rlines">
     {{#each reach.lines}}<li class="rl-{{tone}}">{{twIcon icon}}<span>{{text}}</span></li>{{/each}}
    </ul>
   </div>
  </section>
  <section class="box">
   <div class="sec"><span class="num">§8</span>Readiness</div>
   <div class="ready">
    <div class="rrow">
     <span class="rl">{{twIcon 'wind'}}Dodge fatigue<small>−1 Agility per dodge</small></span>
     <span class="strap" role="group" aria-label="Dodge fatigue {{system.fatigue}}">
      {{#each fatigueNotches}}<button type="button" class="notch{{#if on}} on{{/if}}" data-action="setPath" data-path="system.fatigue" data-value="{{to}}" aria-label="{{label}}" title="{{label}}"{{#unless ../editable}} disabled{{/unless}}></button>{{/each}}
      <b data-live="fatigue" data-live-bad="up">{{system.fatigue}}</b>
     </span>
    </div>
    <button type="button" class="mini wide" data-action="catchBreath">{{twIcon 'refresh'}}Catch breath</button>
    <label class="check"><input type="checkbox" name="system.nextDifficult" {{checked system.nextDifficult}}><span>Next roll is difficult</span></label>
    <label class="check"><input type="checkbox" name="system.dead" {{checked system.dead}}><span>Deceased, by GM ruling</span></label>
   </div>
   <details class="tuck">
    <summary>{{twIcon 'caret'}}Consciousness adjustments</summary>
    <div class="grid2">
     <label class="field"><span>Other loss</span><input type="number" name="{{lossPath}}" value="{{loss}}"></label>
     <label class="field"><span>Max adjustment</span><input type="number" name="{{maxPath}}" value="{{maxAdjustment}}"></label>
    </div>
    <p class="note">Wound loss {{d.woundLoss}} is applied separately and struck out on the track. A negative maximum adjustment strikes boxes off the sheet entirely.</p>
   </details>
  </section>
  {{#if editable}}
  <button type="button" class="recruit" data-action="createCharacter">{{twIcon 'feather'}}Create character</button>
  {{/if}}
{{/if}}
 </aside>
</div>
