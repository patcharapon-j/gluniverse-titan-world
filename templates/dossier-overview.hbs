<div class="ov">
 <div class="ov-main">
  <div class="sec">
   <span class="num">§1</span>Statistics<span class="k">click a card to roll 2d6</span>
   {{#unless isTitan}}{{#if editable}}<button type="button" class="mini" data-action="advance">{{icon 'arrowUp'}}Advance</button>{{/if}}{{/unless}}
  </div>
  <div class="stats">
   {{#each stats}}
   <div class="stat s-{{tone}}{{#if modified}} modified{{/if}}{{#if penalty}} penalised{{/if}}"{{#if why}} title="{{label}} {{display}} — {{why}}"{{/if}}>
    <button type="button" class="stat-hit" data-action="rollStat" data-stat="{{key}}" aria-label="Roll {{label}} {{display}}"></button>
    <div class="stat-key">
     <span class="big" data-live="stat-{{key}}"><span class="sign">{{sign}}</span>{{abs}}</span>
     <label class="base" title="Base {{label}}"><input type="number" name="system.stats.{{key}}" min="-3" max="3" step="1" value="{{value}}" aria-label="Base {{label}}"><span>base</span></label>
    </div>
    <div class="stat-body">
     <div class="stat-top">
      {{icon icon}}<span class="name">{{label}}</span>
      {{#if advanced}}<span class="adv" title="Advanced this campaign">{{icon 'arrowUp'}}</span>{{/if}}
     </div>
     <p class="desc">{{description}}</p>
     {{#if anyReason}}
     <div class="rsns">
      {{#each shown}}<i class="rsn {{tone}}{{#if atRoll}} atroll{{/if}}" title="{{display}} {{label}}{{#if atRoll}} — applied when you roll{{/if}}">{{display}} {{short}}</i>{{/each}}
      {{#if extra}}<i class="rsn more" title="Full breakdown on the Gear tab">+{{extra}} more</i>{{/if}}
     </div>
     {{/if}}
    </div>
    <span class="rollmark">{{icon 'dice'}}Roll</span>
   </div>
   {{/each}}
  </div>

  <div class="sec"><span class="num">§2</span>Condition<span class="k">{{#if d.titan}}Titan{{else}}Human{{/if}} body · click for the log</span></div>
  <div class="cond">
   {{#each ledger}}
   <button type="button" class="loc {{severity}}" data-action="twTab" data-tab="injuries" aria-label="{{label}}: {{headline}}{{#if applied}}, {{applied}}{{/if}}">
    <span class="nm">{{icon icon}}<span>{{short}}</span><i></i></span>
    <span class="sv">{{headline}}</span>
    <span class="locfoot">
     <span class="pips">{{#each pips}}<i class="pip{{#if filled}} on{{/if}}"></i>{{/each}}</span>
     {{#if applied}}<b title="{{applied}}">{{appliedShort}}</b>{{/if}}
    </span>
   </button>
   {{/each}}
  </div>

  {{#unless isTitan}}
  <div class="sec">
   <span class="num">§3</span>Engagement<span class="k">the rolls you reach for first</span>
   <button type="button" class="mini" data-action="twTab" data-tab="actions">All {{actionCount}}{{icon 'chevron'}}</button>
  </div>
  <div class="engage">
   {{#each quickActions}}{{#if primary}}
   <button type="button" class="act primary" data-action="rollMove" data-key="{{key}}">
    {{icon icon}}<span class="an">{{alias}}<small>{{name}} · {{statLabel}} {{modDisplay}}</small></span>{{icon 'dice'}}
   </button>
   {{/if}}{{/each}}
   <div class="fearbar f-{{fear.tone}}">
    <span class="fl">{{icon fear.icon}}Fear</span>
    <span class="fseg" role="group" aria-label="Fear state">
     {{#each fear.states}}
     <button type="button" class="{{#if on}}on{{/if}}" data-action="setFear" data-state="{{key}}" title="{{line}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{label}}</button>
     {{/each}}
    </span>
    <span class="fp">{{fear.line}}</span>
   </div>
   <div class="acts wide">
    {{#each quickActions}}{{#unless primary}}
    <button type="button" class="act s-{{tone}}{{#if difficult}} hard{{/if}}" data-action="rollMove" data-key="{{key}}">
     {{icon icon}}<span class="an">{{name}}<small>{{statShort}} {{modDisplay}}{{#if difficult}} · difficult{{/if}}</small></span>
    </button>
    {{/unless}}{{/each}}
   </div>
  </div>
  {{/unless}}

  {{#if warnings}}
  <div class="sec"><span class="num">{{#if isTitan}}§3{{else}}§4{{/if}}</span>Standing rulings<span class="k">{{warnings.length}} in force</span></div>
  <div class="alerts">
   {{#each warnings}}<div class="alert {{tone}}">{{icon icon}}<span>{{text}}</span></div>{{/each}}
  </div>
  {{/if}}
 </div>

 <aside class="side">
{{#if isTitan}}
  <section class="box">
   <div class="sec"><span class="num">§4</span>Titan profile</div>
   <div class="ready">
    <div class="rrow"><span class="rl">{{icon 'hunting'}}Height</span>
     <span class="num tight">
      <button type="button" data-action="nudge" data-path="system.height" data-delta="-1" data-min="0" aria-label="Shorter">{{icon 'minus'}}</button>
      <b data-live="height">{{system.height}}</b>
      <button type="button" data-action="nudge" data-path="system.height" data-delta="1" data-min="0" aria-label="Taller">{{icon 'plus'}}</button>
     </span>
    </div>
    <div class="rrow"><span class="rl">{{icon 'target'}}Killed by</span><b>Nape strike</b></div>
    <div class="rrow"><span class="rl">{{icon 'body'}}Body</span><b>Fixed at +3</b></div>
   </div>
   <p class="note">Mindless Titans have no consciousness track and no shared luck. Body is fixed at +3 and the nape is the only kill.</p>
  </section>

{{else}}
  <section class="box">
   <div class="sec"><span class="num">§5</span>Field kit<button type="button" class="mini" data-action="twTab" data-tab="equipment">All{{icon 'chevron'}}</button></div>
   <div class="kit">
    {{#if kit}}<div class="khead"><span>Item</span><span>Supply</span><span>Held</span></div>{{/if}}
    {{#each kit}}
    <div class="krow k-{{kind}}{{#if low}} low{{/if}}{{#if empty}} out{{/if}}">
     <button type="button" class="kl" data-action="editItem" data-item-id="{{id}}" title="{{name}}">
      <span class="kchip">{{icon icon}}</span><span class="kn">{{name}}</span>
     </button>
     <span class="gauge{{#if empty}} spent{{/if}}" role="img" aria-label="{{quantity}} of {{#if capacity}}{{capacity}}{{else}}{{quantity}}{{/if}}">
      {{#if empty}}<i class="kstamp">Spent</i>
      {{else}}{{#if pips}}{{#each pips}}<i class="gs{{#if filled}} on{{/if}}"></i>{{/each}}
      {{else}}{{#if single}}<i class="gs one on"></i>
      {{else}}<i class="gbar"><b style="width:{{percent}}%"></b></i>{{/if}}{{/if}}{{/if}}
     </span>
     <span class="kq"><b data-live="kit-{{id}}">{{quantity}}</b>{{#unless pips}}{{#if capacity}}<small>/{{capacity}}</small>{{/if}}{{/unless}}</span>
     <span class="num tight">
      <button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="-1" aria-label="Spend one {{name}}" {{#if empty}}disabled{{/if}}>{{icon 'minus'}}</button>
      <button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="1" aria-label="Restore one {{name}}">{{icon 'plus'}}</button>
     </span>
    </div>
    {{else}}
    <p class="empty">No carried equipment.<br>Prepare a loadout before departure.</p>
    <button type="button" class="mini wide" data-action="equipLoadout">{{icon 'pack'}}Equip a loadout</button>
    {{/each}}
   </div>
  </section>

  <section class="box">
   <div class="sec"><span class="num">§6</span>Shared luck</div>
   {{#if party}}
   <div class="luckbox">
    <div class="lt" data-live="party-luck">{{party.value}}<small>/{{party.max}}</small>
     <span class="pips luck">{{#each luckPips}}<i class="pip round{{#if filled}} on{{/if}}"></i>{{/each}}</span>
    </div>
    <p class="note">One pool, every soldier. Request a spend from your own roll card in chat.</p>
    <button type="button" class="mini wide" data-action="openParty">{{icon 'users'}}Open the pool</button>
   </div>
   {{else}}{{#if isGM}}<button type="button" class="mini wide" data-action="createParty">{{icon 'plusSquare'}}Create a shared pool</button>
   {{else}}<p class="empty">Awaiting the GM's pool.</p>{{/if}}{{/if}}
  </section>

{{/if}}
  <section class="box">
   <div class="sec"><span class="num">{{#if isTitan}}§5{{else}}§7{{/if}}</span>Readiness</div>
   <div class="ready">
    {{#unless isTitan}}
    <div class="rrow">
     <span class="rl">{{icon 'wind'}}Dodge fatigue<small>−1 Agility per dodge</small></span>
     <span class="num tight">
      <button type="button" data-action="nudge" data-path="system.fatigue" data-delta="-1" data-min="0" aria-label="Less fatigue">{{icon 'minus'}}</button>
      <b data-live="fatigue">{{system.fatigue}}</b>
      <button type="button" data-action="nudge" data-path="system.fatigue" data-delta="1" data-min="0" aria-label="More fatigue">{{icon 'plus'}}</button>
     </span>
    </div>
    <button type="button" class="mini wide" data-action="catchBreath">{{icon 'refresh'}}Catch breath</button>
    {{/unless}}
    <label class="check"><input type="checkbox" name="system.nextDifficult" {{checked system.nextDifficult}}><span>Next roll is difficult</span></label>
    <label class="check"><input type="checkbox" name="system.dead" {{checked system.dead}}><span>{{#if isTitan}}Killed{{else}}Deceased{{/if}}, by GM ruling</span></label>
   </div>
   {{#unless isTitan}}
   <details class="tuck">
    <summary>{{icon 'caret'}}Consciousness adjustments</summary>
    <div class="grid2">
     <label class="field"><span>Other loss</span><input type="number" name="{{lossPath}}" value="{{loss}}"></label>
     <label class="field"><span>Max adjustment</span><input type="number" name="{{maxPath}}" value="{{maxAdjustment}}"></label>
    </div>
    <p class="note">Wound loss {{d.woundLoss}} is applied separately and struck out on the track. A negative maximum adjustment strikes boxes off the sheet entirely.</p>
   </details>
   {{/unless}}
  </section>

  {{#unless isTitan}}{{#if editable}}
  <button type="button" class="recruit" data-action="createCharacter">{{icon 'feather'}}Create character</button>
  {{/if}}{{/unless}}
 </aside>
</div>
