{{!-- The catalogue as a card-file drawer: quick rolls, one filter bar, and index cards filed under the statistic they roll. --}}
<div class="sec">
 <span class="num">§1</span>Field actions<span class="k">{{actionCount}} catalogued · click a card to roll</span>
 <button type="button" class="mini" data-action="openCompendium" data-pack="moves">{{twIcon 'book'}}Compendium</button>
</div>

<div class="featured">
 {{#each quickActions}}{{#if primary}}
 <button type="button" class="act primary" data-action="rollMove" data-key="{{key}}" title="{{name}} · {{statLabel}} {{modDisplay}}">
  {{twIcon icon}}<span class="an">{{alias}}<small>{{name}} · {{statLabel}} {{modDisplay}}</small></span>{{twIcon 'dice'}}
 </button>
 {{/if}}{{/each}}
 {{#each quickActions}}{{#unless primary}}
 <button type="button" class="act s-{{tone}}{{#if difficult}} hard{{/if}}" data-action="rollMove" data-key="{{key}}" title="{{name}} · {{statLabel}} {{modDisplay}}{{#if difficult}} · difficult{{/if}}">
  {{twIcon icon}}<span class="an">{{name}}</span><em><b>{{statShort}}</b>{{modDisplay}}</em>
 </button>
 {{/unless}}{{/each}}
</div>

<div class="act-bar">
 <label class="search">{{twIcon 'search'}}<input type="search" data-move-search placeholder="Search actions or source section…" aria-label="Search field actions" spellcheck="false"><small class="stally" data-move-tally aria-live="polite"></small></label>
 <div class="chips stat-chips" role="group" aria-label="Filter by statistic">
  {{#each actionStats}}
  <button type="button" class="chip s-{{tone}}{{#if active}} on{{/if}}" data-action="filterStat" data-stat="{{key}}" title="{{label}} {{mod}} · {{count}} actions" aria-pressed="{{#if active}}true{{else}}false{{/if}}"><span>{{short}}</span><em>{{mod}}</em><b>{{count}}</b></button>
  {{/each}}
 </div>
 <div class="chips cat-chips" role="group" aria-label="Filter by category">
  {{#each actionCategories}}
  <button type="button" class="chip{{#if active}} on{{/if}}" data-action="filterCategory" data-category="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{twIcon icon}}<span>{{label}}</span><b>{{count}}</b></button>
  {{/each}}
 </div>
</div>

{{#if ownedMoves}}
<section class="agroup" data-move-group>
 <div class="sec"><span class="num">{{twIcon 'feather'}}</span>Owned and custom<span class="k">{{ownedMoves.length}}</span></div>
 <div class="alist">
  {{#each ownedMoves}}
  <div class="aitem s-{{tone}}" data-move-name="{{name}} {{source}}">
   <div class="arow owned{{#if difficult}} hard{{/if}}" data-item-id="{{id}}" draggable="true">
    <button type="button" class="ahit" data-action="rollMove" data-item-id="{{id}}" aria-label="Roll {{name}}, {{statLabel}} {{modDisplay}}"></button>
    <span class="atile" title="{{statLabel}} {{modDisplay}}"><b>{{statShort}}</b><em>{{modDisplay}}</em></span>
    <span class="an">{{name}}{{#if line}}<small>{{line}}</small>{{/if}}</span>
    <span class="aflags">{{#if difficult}}<i class="flag hard" title="Difficult: below 10 fails">D</i>{{/if}}{{#if combat}}<i class="flag combat{{#if combatHot}} hot{{/if}}" title="Combat roll">C</i>{{/if}}</span>
    <span class="aedit">
     <button type="button" data-action="editItem" data-item-id="{{id}}" aria-label="Edit {{name}}">{{twIcon 'edit'}}</button>
     <button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">{{twIcon 'trash'}}</button>
    </span>
   </div>
   {{> "systems/gluniverse-titan-world/templates/dossier-outcomes.hbs"}}
  </div>
  {{/each}}
 </div>
</section>
{{/if}}

{{#each actionGroups}}
<section class="agroup" data-move-group>
 <div class="sec"><span class="num">{{twIcon icon}}</span>{{name}}<span class="k">{{count}} actions</span></div>
 {{#each clusters}}
 <div class="cluster s-{{tone}}" data-move-cluster>
  <div class="chead">{{twIcon icon}}<span>{{label}}</span><em>{{mod}}</em><i></i></div>
  <div class="alist">
   {{#each moves}}
   <div class="aitem s-{{tone}}" data-move-name="{{name}} {{source}}">
    <div class="arow{{#if difficult}} hard{{/if}}">
     <button type="button" class="ahit" data-action="rollMove" data-key="{{key}}" aria-label="Roll {{name}}, {{statLabel}} {{modDisplay}}"></button>
     <span class="atile" title="{{statLabel}} {{modDisplay}}"><b>{{statShort}}</b><em>{{modDisplay}}</em></span>
     <span class="an">{{name}}{{#if line}}<small>{{line}}</small>{{/if}}</span>
     <span class="aflags">{{#if difficult}}<i class="flag hard" title="Difficult: below 10 fails">D</i>{{/if}}{{#if combat}}<i class="flag combat{{#if combatHot}} hot{{/if}}" title="Combat roll: difficult at low consciousness">C</i>{{/if}}</span>
     <span class="aroll">{{twIcon 'dice'}}</span>
    </div>
    {{> "systems/gluniverse-titan-world/templates/dossier-outcomes.hbs"}}
   </div>
   {{/each}}
  </div>
 </div>
 {{/each}}
</section>
{{/each}}
<p class="empty" data-move-empty hidden>Nothing matches that search.</p>
<p class="note akey">
 <span><i class="atile"><b>Stat</b><em>±</em></i>rolled statistic, your live modifier</span>
 <span><i class="flag hard">D</i>difficult · below 10 fails</span>
 <span><i class="flag combat hot">C</i>combat · difficult below half consciousness</span>
 <span>{{twIcon 'caret'}}results · every roll card repeats them</span>
</p>
