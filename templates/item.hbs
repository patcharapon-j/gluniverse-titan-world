<div><header class="dossier-head" style="grid-template-columns:48px 1fr"><img class="crest" src="{{item.img}}" alt=""><div class="identity"><div class="eyebrow">{{item.type}}</div><input name="name" value="{{item.name}}" aria-label="Item name"></div></header><div class="sheet-body"><label class="field">Source section<input name="system.source" value="{{system.source}}"></label>
{{#if isMove}}<div class="grid2"><label class="field">Stat<select name="system.stat">{{selectOptions stats selected=system.stat}}</select></label><label class="field">Category<input name="system.category" value="{{system.category}}"></label></div><p><label><input type="checkbox" name="system.difficult" {{checked system.difficult}}> Difficult</label> <label><input type="checkbox" name="system.combat" {{checked system.combat}}> Combat</label></p><button type="button" data-action="roll">Roll action</button><label class="field">10+ result<textarea name="system.success">{{system.success}}</textarea></label><label class="field">7–9 result<textarea name="system.partial">{{system.partial}}</textarea></label><label class="field">Failure result<textarea name="system.failure">{{system.failure}}</textarea></label><label class="field">Snake-eyes result<textarea name="system.snakeEyes">{{system.snakeEyes}}</textarea></label>{{/if}}
{{#if isGear}}<div class="grid2"><label class="field">Quantity<input type="number" min="0" name="system.quantity" value="{{system.quantity}}"></label><label class="field">Uses remaining<input type="number" min="0" name="system.uses" value="{{system.uses}}"></label><label class="field">Stat modified while carried<select name="system.bonusStat">{{selectOptions bonusStats selected=system.bonusStat}}</select></label><label class="field">Modifier<input type="number" name="system.bonus" value="{{system.bonus}}"></label></div><label><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Carried / active</label>{{/if}}
{{#if isPower}}<label class="field">Beast / Female bonus stat (GM choice)<select name="system.bonusStat">{{selectOptions bonusStats selected=system.bonusStat}}</select></label><label><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Use this power when transformed</label>{{/if}}
{{#if isWound}}<div class="grid2"><label class="field">Region<select name="system.region">{{selectOptions regions selected=system.region}}</select></label><label class="field">Severity<select name="system.severity">{{selectOptions severity selected=system.severity}}</select></label><label class="field">Injury type<select name="system.injuryType">{{selectOptions injuryTypes selected=system.injuryType}}</select></label><label class="field">Body / form<select name="system.formScope">{{selectOptions formScopes selected=system.formScope}}</select></label><label class="field">Consciousness lost<input type="number" min="0" name="system.consciousnessLoss" value="{{system.consciousnessLoss}}"></label></div><p><label><input type="checkbox" name="system.treated" {{checked system.treated}}> Treated / bleeding stopped</label></p><p><label><input type="checkbox" name="system.fromMajor" {{checked system.fromMajor}}> Minor wound healed from major</label></p><p><label><input type="checkbox" name="system.healed" {{checked system.healed}}> Healed / ignore this wound</label></p>{{/if}}
<section class="rules">{{{description}}}</section>{{#if editable}}<details><summary>Edit description HTML</summary><textarea name="system.description" style="min-height:180px">{{system.description}}</textarea></details>{{/if}}</div></div>
