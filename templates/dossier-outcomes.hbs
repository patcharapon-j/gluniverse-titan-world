{{!-- One action's authored result ladder, so a player reads what a roll can do before making it. --}}
{{#if anyOutcome}}
<details class="aout">
 <summary>{{twIcon 'caret'}}<span>What each result means</span></summary>
 <ol class="olist">
  {{#each outcomes}}
  <li class="orow {{band}}{{#if struck}} off{{/if}}">
   <span class="ot"><b>{{range}}</b><em>{{label}}</em></span>
   <span class="od">{{text}}{{#if struck}} <i>This roll is difficult: there is no middle result, and anything below 10 fails.</i>{{/if}}</span>
  </li>
  {{/each}}
 </ol>
 {{#if source}}<p class="osrc">{{twIcon 'book'}}Source · {{source}}</p>{{/if}}
</details>
{{/if}}
