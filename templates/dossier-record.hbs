<div class="bg">
 <div class="full">
  <div class="sec"><span class="num">§1</span>Service record<span class="k">Personnel division</span>
   <button type="button" class="mini" data-action="openCompendium" data-pack="advancement">{{icon 'arrowUp'}}Advancement</button>
  </div>
  <div class="reqlines">
   <label class="reqline"><span class="lab">{{icon 'flag'}}Regiment</span><input name="system.regiment" value="{{system.regiment}}"></label>
   <label class="reqline"><span class="lab">{{icon 'duty'}}Rank</span><input name="system.rank" value="{{system.rank}}"></label>
   <label class="reqline"><span class="lab">{{icon 'map'}}Origin</span><input name="system.origin" value="{{system.origin}}"></label>
   <label class="reqline"><span class="lab">{{icon 'body'}}Height (m)</span><input type="number" step="0.1" min="0" name="system.height" value="{{system.height}}"></label>
  </div>
 </div>
 <div>
  <div class="sec"><span class="num">§2</span>Anchor<span class="k">why you come back</span></div>
  <label class="field"><textarea name="system.anchor" class="ruled" placeholder="The person, place or promise waiting behind the wall.">{{system.anchor}}</textarea></label>
 </div>
 <div>
  <div class="sec"><span class="num">§3</span>Drive<span class="k">why you go out</span></div>
  <label class="field"><textarea name="system.drive" class="ruled" placeholder="The debt, the shame or the question that pushes you past the gate.">{{system.drive}}</textarea></label>
 </div>
 <div class="full">
  <div class="sec"><span class="num">§4</span>Background</div>
  <label class="field"><textarea name="system.background" class="ruled tall">{{system.background}}</textarea></label>
 </div>
 <div class="full">
  <div class="sec"><span class="num">§5</span>Mission notes and GM rulings</div>
  <label class="field"><textarea name="system.notes" class="ruled tall">{{system.notes}}</textarea></label>
 </div>
 <div class="full">
  <div class="sec"><span class="num">§6</span>Growth record</div>
  <ul class="rewards">
   {{#each stats}}
   <li class="{{#if advanced}}on{{/if}}">
    <i class="pip{{#if advanced}} on{{/if}}"></i>{{icon icon}}
    <span>{{label}}<small>{{#if advanced}}Advanced · base {{value}}{{else}}{{#if capped}}At the +3 ceiling{{else}}Available once, to a maximum of +3{{/if}}{{/if}}</small></span>
    <b>{{display}}</b>
   </li>
   {{/each}}
  </ul>
  {{#if editable}}<button type="button" class="mini primary" data-action="advance">{{icon 'arrowUp'}}Record an advancement</button>{{/if}}
 </div>
</div>
