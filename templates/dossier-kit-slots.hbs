<span class="kslots">{{#each slots}}<button type="button" class="kobj {{#if on}}on{{else}}off{{/if}}" data-action="{{#if on}}kitSpend{{else}}kitRestore{{/if}}" data-item-id="{{../id}}" title="{{#if on}}{{../spend}}{{else}}{{../restore}}{{/if}}" aria-label="{{../name}}: {{#if on}}{{../spend}}{{else}}{{../restore}}{{/if}}"{{#unless @root.editable}} disabled{{/unless}}><svg class="ko" viewBox="{{../box}}"{{#if ../colour}} style="color:{{../colour}}"{{/if}} aria-hidden="true"><use href="#tw-k-{{../object}}"/></svg></button>{{/each}}{{#if overflow}}<i class="kbadge" title="{{quantity}} carried">×{{overflow}}</i>{{/if}}</span>
