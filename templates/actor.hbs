<div class="dossier-page">
 {{> "systems/gluniverse-titan-world/templates/dossier-header.hbs"}}
 {{#if isParty}}
 <div class="sheet-body"><h2>Shared party luck</h2><p>Set one or two points per player. Players request luck on their own roll cards; the GM approves each spend.</p><div class="grid2"><label class="field">Available<input name="system.luck.value" type="number" min="0" value="{{system.luck.value}}"></label><label class="field">Mission maximum<input name="system.luck.max" type="number" min="0" value="{{system.luck.max}}"></label></div>{{#if isGM}}<button type="button" data-action="resetMission">Refresh for next mission</button>{{/if}}<label class="field">Mission notes<textarea name="system.notes">{{system.notes}}</textarea></label></div>
 {{else}}
 <nav class="tabs" aria-label="Dossier sections">{{#each tabs}}<button type="button" data-action="twTab" data-tab="{{key}}" class="{{#if active}}active{{/if}}" aria-current="{{#if active}}page{{else}}false{{/if}}"><span class="tab-index">{{index}}</span>{{label}}</button>{{/each}}</nav>
 <div class="sheet-body">
 {{#if record}}{{> "systems/gluniverse-titan-world/templates/dossier-overview.hbs"}}{{/if}}
 {{#if actions}}<div class="section-head"><h2>Field actions</h2><button type="button" data-action="openCompendium" data-pack="moves">Open compendium</button></div><input data-move-search placeholder="Search actions…" aria-label="Search field actions"><p class="note">Roll cards include the complete source section. Compare opposed rolls in chat. GM consequence controls record the approved result.</p>{{#each groups}}<section class="panel"><h3>{{name}}</h3>{{#each moves}}<div class="move" data-move-name="{{name}}"><div>{{name}}<small>{{system.stat}}{{#if system.difficult}} · Difficult{{/if}}</small></div><button type="button" data-action="rollMove" data-key="{{system.key}}">Roll</button></div>{{/each}}</section>{{/each}}{{#if ownedMoves}}<section class="panel"><h3>Owned / custom actions</h3>{{#each ownedMoves}}<div class="move draggable" data-item-id="{{id}}"><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><button type="button" data-action="rollMove" data-item-id="{{id}}">Roll</button><button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">Remove</button></div>{{/each}}</section>{{/if}}{{/if}}
 {{#if equipment}}<div class="section-head"><h2>Equipment</h2><div class="inline"><button type="button" data-action="equipLoadout">Equip loadout</button><button type="button" data-action="openCompendium" data-pack="equipment">Compendium</button></div></div><p class="note">Ammunition and gas are abstract supplies. Adjust counts when the GM calls for expenditure. No automatic per-shot consumption.</p><table class="inventory"><thead><tr><th>Item</th><th>Quantity</th><th>Carried</th><th></th></tr></thead><tbody>{{#each gear}}<tr class="draggable" data-item-id="{{id}}"><td><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{#if system.uses}}<small> · {{system.uses}} uses</small>{{/if}}</td><td><button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="-1" aria-label="Use one {{name}}">−</button> {{system.quantity}} <button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="1" aria-label="Add one {{name}}">+</button></td><td><button type="button" data-action="toggleEquipped" data-item-id="{{id}}">{{#if system.equipped}}Yes{{else}}No{{/if}}</button></td><td><button type="button" class="danger" data-action="deleteItem" data-item-id="{{id}}">Remove</button></td></tr>{{else}}<tr><td colspan="4" class="empty">Choose a loadout or drag equipment from the compendium.</td></tr>{{/each}}</tbody></table>{{#each loadouts}}<div class="move"><span>{{name}}</span><button type="button" data-action="useLoadout" data-item-id="{{id}}">Unpack</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></div>{{/each}}{{/if}}
 {{#if injuries}}<div class="section-head"><h2>Injury ledger</h2><div class="inline"><button type="button" data-action="addWound">Record injury</button><button type="button" data-action="openCompendium" data-pack="injuries">Templates</button></div></div><div class="injury-atlas"><figure class="body-atlas"><svg viewBox="0 0 200 380" role="img" aria-label="Current body injury diagram"><path class="atlas-guide" d="M100 0V374M20 80H180M20 196H180M20 300H180"/>{{#each regions}}<path class="anatomy {{severity}}" d="{{path}}"><title>{{label}}: {{summary}}</title></path>{{/each}}</svg><figcaption>Fig. I · {{#if d.titan}}Titan{{else}}Human{{/if}} body</figcaption></figure><div class="region-ledger">{{#each regions}}<div class="region-entry {{severity}}"><span>{{label}}</span><strong>{{summary}}</strong><span class="pips">{{#each pips}}<i class="pip {{#if filled}}filled{{/if}}"></i>{{/each}}</span></div>{{/each}}<p class="note">Amber: minor · Red: major<br>Ink: crippling<br>Healed wounds remain in the ledger.</p></div></div><p class="note">Only wounds belonging to the current body affect stats. Each wound’s loss, treatment, and form can be edited. GM decides bleeding, amputation, recovery, and death.</p>{{#each wounds}}<div class="move draggable" data-item-id="{{id}}"><div><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><small>{{system.formScope}} body · consciousness loss {{system.consciousnessLoss}}{{#if system.fromMajor}} · healed from major{{/if}}{{#if system.treated}} · treated{{/if}}</small></div><div class="inline"><button type="button" data-action="treatWound" data-item-id="{{id}}">Treat</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></div></div>{{else}}<p class="empty">No recorded wounds.</p>{{/each}}{{/if}}
 {{#if powers}}<div class="inheritance-banner"><span class="inheritance-seal" aria-hidden="true">IX</span><div><div class="eyebrow">Restricted archive / Titan inheritance</div><h3>{{#if ownedPowers}}Power carries a price.{{else}}An unclaimed inheritance.{{/if}}</h3><p>{{#if ownedPowers}}Your powers, current form, and remaining years.{{else}}Add an inherited power from the Nine Powers compendium to begin a shifter record.{{/if}}</p></div></div><div class="section-head"><h2>Titan powers</h2><button type="button" data-action="openCompendium" data-pack="powers">Nine powers</button></div><p class="note">Enable powers used in the current transformation. Beast and Female bonuses require selecting the appropriate stat in the power item. Confirm conflicting or combined powers with the GM.</p><div class="inline"><button type="button" data-action="shift">{{#if system.shift.active}}Leave Titan form{{else}}Enter Titan form{{/if}}</button><label><input type="checkbox" name="system.shift.experienced" {{checked system.shift.experienced}}> Experienced shifter</label><label><input type="checkbox" name="system.shift.armourIntact" {{checked system.shift.armourIntact}}> Armour intact</label></div><div class="grid2" style="margin-top:16px"><label class="field">Height (metres)<input type="number" name="system.height" value="{{system.height}}" step="0.1" min="0"></label><label class="field">Years remaining under Ymir’s curse<input type="number" name="system.shift.yearsRemaining" value="{{system.shift.yearsRemaining}}" min="0"></label><label class="field">Absorption cumulative penalty<input type="number" name="system.shift.absorption" value="{{system.shift.absorption}}" min="0"></label></div>{{#each ownedPowers}}<div class="move draggable" data-item-id="{{id}}"><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><button type="button" data-action="toggleEquipped" data-item-id="{{id}}">{{#if system.equipped}}Enabled{{else}}Disabled{{/if}}</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></div>{{else}}<p class="empty">Drag a Titan power from the compendium to acquire it.</p>{{/each}}<label class="field">Form, borrowed ability, and GM rulings<textarea name="system.shift.notes">{{system.shift.notes}}</textarea></label>{{/if}}
 {{#if background}}<div class="record-fields"><div class="section-head"><h2>Service record</h2><span class="eyebrow">Personnel division</span></div><div class="grid2"><label class="field">Regiment<input name="system.regiment" value="{{system.regiment}}"></label><label class="field">Rank<input name="system.rank" value="{{system.rank}}"></label><label class="field">Origin<input name="system.origin" value="{{system.origin}}"></label><label class="field">Height (metres)<input type="number" step="0.1" name="system.height" value="{{system.height}}"></label></div><label class="field">Anchor · Why you return<textarea name="system.anchor">{{system.anchor}}</textarea></label><label class="field">Drive · Why you leave<textarea name="system.drive">{{system.drive}}</textarea></label><label class="field">Background<textarea name="system.background">{{system.background}}</textarea></label><label class="field">Mission notes and GM rulings<textarea name="system.notes">{{system.notes}}</textarea></label><button type="button" data-action="openCompendium" data-pack="advancement">Advancement reference</button></div>{{/if}}
 </div><footer class="footer"><span>Titan World · Field dossier</span><span>Personnel division / III</span></footer>{{/if}}
</div>
