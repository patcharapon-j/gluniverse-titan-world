<div>
 <header class="dossier-head"><img class="crest" src="{{actor.img}}" alt="{{actor.name}}" data-action="editPortrait"><div class="identity"><div class="eyebrow">Titan World · Third edition · Functional sheet</div><input name="name" value="{{actor.name}}" aria-label="Character name"><div class="meta">{{system.regiment}} / {{system.rank}}</div></div><button type="button" data-action="openRules">System guide</button></header>
 {{#if isParty}}
 <div class="sheet-body"><h2>Shared party luck</h2><p>Set one or two points per player. Players request luck on their own roll cards; the GM approves each spend.</p><div class="grid2"><label class="field">Available<input name="system.luck.value" type="number" min="0" value="{{system.luck.value}}"></label><label class="field">Mission maximum<input name="system.luck.max" type="number" min="0" value="{{system.luck.max}}"></label></div>{{#if isGM}}<button type="button" data-action="resetMission">Refresh for next mission</button>{{/if}}<label class="field">Mission notes<textarea name="system.notes">{{system.notes}}</textarea></label></div>
 {{else}}
 <nav class="tabs">{{#each tabs}}<button type="button" data-action="twTab" data-tab="{{key}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}</nav>
 <div class="sheet-body">
 {{#if record}}
 <div class="section-head"><span class="eyebrow">Aptitude assessment</span>{{#if editable}}<div class="inline"><button type="button" data-action="createCharacter">Create character</button><button type="button" data-action="advance">Advance stat</button></div>{{/if}}</div>
 <div class="stat-grid">{{#each stats}}<div class="stat"><label>{{label}}</label><button type="button" data-action="rollStat" data-stat="{{key}}" title="Roll {{label}}">{{display}}</button><input name="system.stats.{{key}}" type="number" min="-3" max="3" value="{{value}}" aria-label="Base {{label}}">{{#if advanced}}<small title="Already increased through advancement">↑</small>{{/if}}</div>{{/each}}</div>
 <div class="columns"><section class="panel"><h2>Titan engagement</h2><p class="note">Confirm distraction, position, and eligibility with the GM. Each action below is a separate roll; a failure does not permit repeated attempts without a new approach.</p>{{#each quickMoves}}<div class="move"><div><h3>{{name}}</h3><small>{{system.stat}} · {{system.source}}</small></div><button type="button" data-action="rollMove" data-key="{{system.key}}">Roll</button></div>{{/each}}<button type="button" data-action="twTab" data-tab="actions" style="margin-top:14px">Browse all 77 field actions</button></section>
 <aside><div class="readiness"><div class="eyebrow">{{#if d.mindless}}Mindless Titan{{else}}Consciousness{{/if}}</div>{{#unless d.mindless}}<div class="consciousness">{{d.value}} <small>/ {{d.max}}</small></div><div class="meter">{{#each meter}}<i class="{{#if empty}}empty{{/if}}"></i>{{/each}}</div>{{/unless}}<strong>{{d.status}}</strong></div>
 {{#if d.deathReview}}<p class="warning">Death threshold reached under the documented interpretation. GM review required.</p>{{/if}}{{#if d.combatDifficult}}<p class="warning">Combat rolls are difficult at this consciousness.</p>{{/if}}
 <label class="field">Other consciousness loss<input type="number" name="{{lossPath}}" value="{{loss}}"></label><label class="field">Maximum adjustment (GM ruling)<input type="number" name="{{maxPath}}" value="{{maxAdjustment}}"></label><p class="note">Active wound loss: {{d.woundLoss}}. Negative other loss restores consciousness, up to the maximum.</p>
 <label class="field">Dodge fatigue<input type="number" min="0" name="system.fatigue" value="{{system.fatigue}}"></label><button type="button" data-action="catchBreath">Catch breath</button><p><label><input type="checkbox" name="system.nextDifficult" {{checked system.nextDifficult}}> Next roll difficult</label></p><p><label><input type="checkbox" name="system.dead" {{checked system.dead}}> Deceased (GM ruling)</label></p>
 <section class="panel"><h3>Party luck</h3>{{#if party}}<p>{{party.value}} / {{party.max}}</p><button type="button" data-action="openParty">Open pool</button>{{else}}{{#if isGM}}<button type="button" data-action="createParty">Create shared pool</button>{{else}}<p class="note">The GM has not created a pool.</p>{{/if}}{{/if}}</section></aside></div>
 {{/if}}
 {{#if actions}}<div class="section-head"><h2>Field actions</h2><button type="button" data-action="openCompendium" data-pack="moves">Open compendium</button></div><input data-move-search placeholder="Search actions…" aria-label="Search field actions"><p class="note">Roll cards include the complete source section. Compare opposed rolls in chat. GM consequence controls record the approved result.</p>{{#each groups}}<section class="panel"><h3>{{name}}</h3>{{#each moves}}<div class="move" data-move-name="{{name}}"><div>{{name}}<small>{{system.stat}}{{#if system.difficult}} · Difficult{{/if}}</small></div><button type="button" data-action="rollMove" data-key="{{system.key}}">Roll</button></div>{{/each}}</section>{{/each}}{{#if ownedMoves}}<section class="panel"><h3>Owned / custom actions</h3>{{#each ownedMoves}}<div class="move draggable" data-item-id="{{id}}"><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><button type="button" data-action="rollMove" data-item-id="{{id}}">Roll</button><button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">Remove</button></div>{{/each}}</section>{{/if}}{{/if}}
 {{#if equipment}}<div class="section-head"><h2>Equipment</h2><div class="inline"><button type="button" data-action="equipLoadout">Equip loadout</button><button type="button" data-action="openCompendium" data-pack="equipment">Compendium</button></div></div><p class="note">Ammunition and gas are abstract supplies. Adjust counts when the GM calls for expenditure. No automatic per-shot consumption.</p><table class="inventory"><thead><tr><th>Item</th><th>Quantity</th><th>Carried</th><th></th></tr></thead><tbody>{{#each gear}}<tr class="draggable" data-item-id="{{id}}"><td><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{#if system.uses}}<small> · {{system.uses}} uses</small>{{/if}}</td><td><button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="-1" aria-label="Use one {{name}}">−</button> {{system.quantity}} <button type="button" data-action="quantity" data-item-id="{{id}}" data-delta="1" aria-label="Add one {{name}}">+</button></td><td><button type="button" data-action="toggleEquipped" data-item-id="{{id}}">{{#if system.equipped}}Yes{{else}}No{{/if}}</button></td><td><button type="button" class="danger" data-action="deleteItem" data-item-id="{{id}}">Remove</button></td></tr>{{else}}<tr><td colspan="4" class="empty">Choose a loadout or drag equipment from the compendium.</td></tr>{{/each}}</tbody></table>{{#each loadouts}}<div class="move"><span>{{name}}</span><button type="button" data-action="useLoadout" data-item-id="{{id}}">Unpack</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></div>{{/each}}{{/if}}
 {{#if injuries}}<div class="section-head"><h2>Injury ledger</h2><div class="inline"><button type="button" data-action="addWound">Record injury</button><button type="button" data-action="openCompendium" data-pack="injuries">Templates</button></div></div><p class="note">Only wounds belonging to the current body affect stats. Each wound’s loss, treatment, and form can be edited. GM decides bleeding, amputation, recovery, and death.</p>{{#each wounds}}<div class="move draggable" data-item-id="{{id}}"><div><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><small>{{system.formScope}} body · consciousness loss {{system.consciousnessLoss}}{{#if system.fromMajor}} · healed from major{{/if}}{{#if system.treated}} · treated{{/if}}</small></div><div class="inline"><button type="button" data-action="treatWound" data-item-id="{{id}}">Treat</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></div></div>{{else}}<p class="empty">No recorded wounds.</p>{{/each}}{{/if}}
 {{#if powers}}<div class="section-head"><h2>Titan powers</h2><button type="button" data-action="openCompendium" data-pack="powers">Nine powers</button></div><p class="note">Enable powers used in the current transformation. Beast and Female bonuses require selecting the appropriate stat in the power item. Confirm conflicting or combined powers with the GM.</p><div class="inline"><button type="button" data-action="shift">{{#if system.shift.active}}Leave Titan form{{else}}Enter Titan form{{/if}}</button><label><input type="checkbox" name="system.shift.experienced" {{checked system.shift.experienced}}> Experienced shifter</label><label><input type="checkbox" name="system.shift.armourIntact" {{checked system.shift.armourIntact}}> Armour intact</label></div><div class="grid2" style="margin-top:16px"><label class="field">Height (metres)<input type="number" name="system.height" value="{{system.height}}" step="0.1" min="0"></label><label class="field">Years remaining under Ymir’s curse<input type="number" name="system.shift.yearsRemaining" value="{{system.shift.yearsRemaining}}" min="0"></label><label class="field">Absorption cumulative penalty<input type="number" name="system.shift.absorption" value="{{system.shift.absorption}}" min="0"></label></div>{{#each ownedPowers}}<div class="move draggable" data-item-id="{{id}}"><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button><button type="button" data-action="toggleEquipped" data-item-id="{{id}}">{{#if system.equipped}}Enabled{{else}}Disabled{{/if}}</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></div>{{else}}<p class="empty">Drag a Titan power from the compendium to acquire it.</p>{{/each}}<label class="field">Form, borrowed ability, and GM rulings<textarea name="system.shift.notes">{{system.shift.notes}}</textarea></label>{{/if}}
 {{#if background}}<div class="grid2"><label class="field">Regiment<input name="system.regiment" value="{{system.regiment}}"></label><label class="field">Rank<input name="system.rank" value="{{system.rank}}"></label><label class="field">Origin<input name="system.origin" value="{{system.origin}}"></label><label class="field">Height (metres)<input type="number" step="0.1" name="system.height" value="{{system.height}}"></label></div><label class="field">Anchor · Why you return<textarea name="system.anchor">{{system.anchor}}</textarea></label><label class="field">Drive · Why you leave<textarea name="system.drive">{{system.drive}}</textarea></label><label class="field">Background<textarea name="system.background">{{system.background}}</textarea></label><label class="field">Mission notes and GM rulings<textarea name="system.notes">{{system.notes}}</textarea></label><button type="button" data-action="openCompendium" data-pack="advancement">Advancement reference</button>{{/if}}
 </div><footer class="footer"><span>Temporary functional sheet · visual design pending</span><span>Foundry VTT 14 only</span></footer>{{/if}}
</div>
