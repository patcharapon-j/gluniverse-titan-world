<div class="dossier-page{{#if isParty}} is-party{{/if}}{{#if isTitan}} is-titan{{/if}}{{#if system.nextDifficult}} is-difficult{{/if}}">
 {{{sprite}}}
 <i class="paper-grain" aria-hidden="true"></i><i class="paper-foxing" aria-hidden="true"></i>
 <i class="paper-crease" aria-hidden="true"></i><i class="paper-margin" aria-hidden="true"></i>
 <i class="eyelet e1" aria-hidden="true"></i><i class="eyelet e2" aria-hidden="true"></i><i class="eyelet e3" aria-hidden="true"></i>
 {{> "systems/gluniverse-titan-world/templates/dossier-header.hbs"}}
 {{#if isParty}}
  <div class="sheet-body">{{> "systems/gluniverse-titan-world/templates/dossier-party.hbs"}}</div>
 {{else}}
  <nav class="tabs" role="tablist" aria-label="Dossier sections">
   {{#each tabs}}
   <button type="button" role="tab" data-action="twTab" data-tab="{{key}}" class="{{#if active}}active{{/if}}" aria-selected="{{#if active}}true{{else}}false{{/if}}">
    <span class="n">{{index}}</span>{{twIcon icon}}<span class="tl">{{label}}</span>
   </button>
   {{/each}}
  </nav>
  {{#if system.nextDifficult}}
  <div class="difficult-bar" role="status">
   <span class="db-s">{{twIcon 'stamp'}}Difficult</span>
   <span class="db-p"><b>Your next roll is difficult.</b> Below 10 always fails — there is no 7–9 result. It clears itself the moment you roll.</span>
   {{#if editable}}<button type="button" class="mini" data-action="clearDifficult">{{twIcon 'close'}}Clear</button>{{/if}}
  </div>
  {{/if}}
  <div class="sheet-body">
   {{#if record}}{{> "systems/gluniverse-titan-world/templates/dossier-overview.hbs"}}{{/if}}
   {{#if actions}}{{> "systems/gluniverse-titan-world/templates/dossier-actions.hbs"}}{{/if}}
   {{#if injuries}}{{> "systems/gluniverse-titan-world/templates/dossier-wounds.hbs"}}{{/if}}
   {{#if equipment}}{{> "systems/gluniverse-titan-world/templates/dossier-gear.hbs"}}{{/if}}
   {{#if powers}}{{> "systems/gluniverse-titan-world/templates/dossier-shifter.hbs"}}{{/if}}
   {{#if background}}{{> "systems/gluniverse-titan-world/templates/dossier-record.hbs"}}{{/if}}
  </div>
 {{/if}}
 <footer class="footer">
  <span>{{twIcon 'wings'}} Titan World · Field dossier</span>
  <span>Personnel division / III</span>
 </footer>
</div>
