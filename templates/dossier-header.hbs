<header class="dossier-head">
 <button type="button" class="portrait-frame" data-action="editPortrait" aria-label="Change character portrait">
  {{#if portraitAvailable}}<img src="{{actor.img}}" alt="{{actor.name}}">{{else}}<span class="portrait-placeholder"><img src="systems/gluniverse-titan-world/assets/crest.svg" alt=""><span>No photograph<br>on file</span></span>{{/if}}
 </button>
 <div class="identity"><div class="eyebrow">{{#if isParty}}Expedition command{{else}}Personnel archive · Titan World{{/if}}</div><input name="name" value="{{actor.name}}" aria-label="Character name"><div class="identity-meta"><span>{{#if system.regiment}}{{system.regiment}}{{else}}Regiment unassigned{{/if}}</span><span>{{#if system.rank}}{{system.rank}}{{else}}Service record{{/if}}</span></div><div class="identity-tags">{{#if isParty}}<span class="tag">Shared resource</span><span class="tag status-tag">GM managed</span>{{else}}<span class="tag">{{#if d.titan}}Titan body{{else}}Human body{{/if}}</span><span class="tag status-tag">{{d.status}}</span>{{/if}}<button type="button" class="text-button" data-action="openRules">System guide <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button></div></div>
 <div class="header-readiness"><span class="serial">File / {{serial}}</span>{{#if isParty}}<span class="eyebrow">Party luck</span><div class="vital-value" data-live="luck">{{system.luck.value}}<small>/ {{system.luck.max}}</small></div>{{else}}<span class="eyebrow">{{#if d.mindless}}Titan status{{else}}Consciousness{{/if}}</span>{{#if d.mindless}}<span class="titan-status">Nape intact</span>{{else}}<div class="vital-value" data-live="consciousness">{{d.value}}<small>/ {{d.max}}</small></div><div class="meter" aria-label="Consciousness {{d.value}} of {{d.max}}">{{#each meter}}<i class="{{#if empty}}empty{{/if}}"></i>{{/each}}</div>{{/if}}{{/if}}</div>
</header>
